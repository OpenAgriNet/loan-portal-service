# Copy to .env and fill in. The .env is the ONLY place secrets live.

# ---- portal login (single shared credential) ----
PORTAL_PASSWORD=change-me-to-a-strong-shared-password
SESSION_SECRET=                 # random string; set it so sessions survive password rotation
SESSION_HOURS=8                 # cookie lifetime (hours)
COOKIE_SECURE=true              # set false ONLY for plain-http local dev
PORTAL_ACTOR=portal:shared      # redeemed_by / audit actor (becomes Keycloak username in v2)

# ---- admin login (SEPARATE, more-powerful surface: bulk eligibility + code mgmt) ----
# Distinct password + distinct cookie/scope from the verify login above. Because
# the portal is now publicly routed (loan-portal.dev.amulai.in), make this a
# STRONG, distinct secret. IP-allowlist / Keycloak is the recommended next step.
ADMIN_PASSWORD=change-me-to-a-strong-DISTINCT-admin-password
ADMIN_ACTOR=admin:shared        # audit actor for admin_upload / admin_remove / admin_clear
# ADMIN_UPLOAD_MAX_BYTES=5242880  # max eligibility upload size (default 5 MiB)

# ---- database (dedicated amul_loan Postgres) ----
# asyncpg driver DSN. Example (VM2-db): postgresql+asyncpg://amul_loan:PASS@10.5.25.12:5432/amul_loan
LOAN_DB_URL=postgresql+asyncpg://amul_loan:PASSWORD@HOST:5432/amul_loan

# ---- host port ----
WEB_PORT=8085

# ---- rate limiting (optional overrides) ----
# CODE_LOOKUPS_PER_SESSION=5
# CODE_LOOKUPS_PER_IP=20
# RATE_WINDOW_MIN=10
# NONCE_TTL=300
